{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "remember-me": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "skipTests": true,
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "reme",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/remember-me",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "loader": {
              ".txt": "text"
            },
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets"
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "cloud": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.cloud.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Content-Security-Policy": "default-src 'self'; script-src 'self' https://storage.ko-fi.com https://maps.googleapis.com https://maps.gstatic.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://storage.ko-fi.com https://cdn.ko-fi.com; img-src 'self' data: https: https://maps.googleapis.com https://maps.gstatic.com; connect-src 'self' http://localhost:8081 http://localhost:7072 http://localhost:9099 http://127.0.0.1:9099 https://hasura.orangemeadow-efd57554.germanywestcentral.azurecontainerapps.io https://fa-rememberme-backend-cchucab0bsdpepb5.germanywestcentral-01.azurewebsites.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://maps.googleapis.com https://maps.gstatic.com; frame-src https://ko-fi.com https://storage.ko-fi.com; font-src 'self' data: https://fonts.gstatic.com https://maps.gstatic.com; object-src 'none'"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "remember-me:build:production"
            },
            "development": {
              "buildTarget": "remember-me:build:development"
            },
            "cloud": {
              "buildTarget": "remember-me:build:cloud"
            },
            "e2e": {
              "buildTarget": "remember-me:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "browsers": [
              "Chromium"
            ],
            "tsConfig": "tsconfig.spec.json"
          },
          "configurations": {
            "ci": {
              "watch": false,
              "browsers": ["ChromiumHeadless"]
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
